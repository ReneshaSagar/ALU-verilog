
`timescale 1ns / 1ps

module ALU_tb;

    // Inputs
    reg [31:0] A;
    reg [31:0] B;
    reg [2:0] Op_code;

    // Output
    wire [31:0] Y;

    integer passed;
    integer failed;

    // Instantiate ALU
    ALU DUT (
        .A(A),
        .B(B),
        .Op_code(Op_code),
        .Y(Y)
    );

    // Task to verify ALU operations
    task check_result;
        input [31:0] a, b;
        input [2:0] opcode;
        input [31:0] expected;

        begin
            A = a;
            B = b;
            Op_code = opcode;

            #10;

            if (Y === expected) begin
                $display("PASS | Opcode: %b | Result: %h",
                         opcode, Y);
                passed = passed + 1;
            end
            else begin
                $display("FAIL | Opcode: %b | Expected: %h | Got: %h",
                         opcode, expected, Y);
                failed = failed + 1;
            end
        end
    endtask

    // Test execution
    initial begin

    $dumpfile("alu_wave.vcd");
    $dumpvars(0, ALU_tb);

    passed = 0;
    failed = 0;

        $display("--------------------------------");
        $display("       ALU FUNCTIONAL TEST       ");
        $display("--------------------------------");

        // 1. Pass A
        check_result(32'd10, 32'd5, 3'b000, 32'd10);

        // 2. Addition
        check_result(32'd10, 32'd5, 3'b001, 32'd15);

        // 3. Subtraction
        check_result(32'd10, 32'd5, 3'b010, 32'd5);

        // 4. Bitwise AND
        check_result(32'hFF00, 32'h0FF0,
                     3'b011, 32'h0F00);

        // 5. Bitwise OR
        check_result(32'hFF00, 32'h0FF0,
                     3'b100, 32'hFFF0);

        // 6. Increment
        check_result(32'd10, 32'd0, 3'b101, 32'd11);

        // 7. Decrement
        check_result(32'd10, 32'd0, 3'b110, 32'd9);

        // 8. Pass B
        check_result(32'd10, 32'd25, 3'b111, 32'd25);

        // Boundary tests
        check_result(32'hFFFFFFFF, 32'd1,
                     3'b001, 32'd0);

        check_result(32'd0, 32'd1,
                     3'b010, 32'hFFFFFFFF);

        // Final report
        $display("--------------------------------");
        $display("         TEST SUMMARY            ");
        $display("Passed Tests : %0d", passed);
        $display("Failed Tests : %0d", failed);
        $display("--------------------------------");

        if (failed == 0)
            $display("RESULT: ALL TESTS PASSED!");
        else
            $display("RESULT: SOME TESTS FAILED!");

        $finish;
    end

endmodule
